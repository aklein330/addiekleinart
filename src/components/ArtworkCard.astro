---
import { Image } from 'astro:assets';
import { formatPrice, type Artwork } from '../lib/artworks';

interface Props {
  artwork: Artwork;
  eager?: boolean;
  showPrice?: boolean;
}

const { artwork, eager = false, showPrice = false } = Astro.props;
const { title, image, alt, year, status, price } = artwork.data;
---

<a class="card" href={`/portfolio/${artwork.id}`} data-category={artwork.data.category}>
  <div class="frame">
    <Image
      src={image}
      alt={alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <div class="meta">
    <span class="title">{title}</span>
    <span class="detail">
      {showPrice && price ? formatPrice(price) : year}
      {status === 'sold' && <span class="dot" title="Sold"></span>}
    </span>
  </div>
</a>

<style>
  .card {
    display: block;
    break-inside: avoid;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .frame {
    overflow: hidden;
    background: var(--paper-deep);
  }

  .frame :global(img) {
    width: 100%;
    transition: transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1), opacity 0.4s;
  }

  .card:hover .frame :global(img) {
    transform: scale(1.025);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-top: 0.9rem;
  }

  .title {
    font-family: var(--serif);
    font-size: 1.2rem;
  }

  .detail {
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 0.5rem;
    border-radius: 50%;
    background: #a3432f;
    vertical-align: 1px;
  }
</style>
