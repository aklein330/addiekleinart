---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';
import { site } from '../site.config';
import { resolveImage } from '../lib/images';

const about = (await getEntry('pages', 'about'))!;
const { Content } = await render(about);
const portrait = resolveImage(about.data.portrait);
---

<Base title="About" description={`About ${site.artistName}, painter of landscapes and wildlife.`}>
  <section class="container about">
    <figure>
      <Image src={portrait} alt={about.data.portraitAlt} widths={[500, 900]} sizes="(max-width: 800px) 100vw, 40vw" />
      {about.data.caption && <figcaption>{about.data.caption}</figcaption>}
    </figure>

    <div class="text">
      <p class="eyebrow">{about.data.title}</p>
      <h1 translate="no">{site.artistName}</h1>
      {about.data.lede && <p class="lede">{about.data.lede}</p>}
      <Content />
    </div>
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  figure {
    margin: 0;
    position: sticky;
    top: 120px;
  }

  figcaption {
    padding-top: 0.8rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .text :global(h2) {
    font-size: 1.7rem;
    margin-top: 2.5rem;
  }

  .text :global(a) {
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
    }

    figure {
      position: static;
    }
  }
</style>
