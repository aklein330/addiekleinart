---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getArtworks } from '../lib/artworks';
import { site } from '../site.config';

const available = (await getArtworks()).filter((a) => a.data.status === 'available' && a.data.price);
---

<Base title="Shop" description="Original paintings available for purchase." noindex={!site.shopEnabled}>
  <header class="page-header container">
    <p class="eyebrow">Shop</p>
    <h1>Available works</h1>
    {
      !site.shopEnabled && (
        <p class="lede">
          Online purchasing is coming soon. In the meantime,{' '}
          {available.length ? (
            <>
              <a class="link" href="/contact">get in touch</a> to acquire any of the works below.
            </>
          ) : (
            <>
              explore the <a class="link" href="/portfolio">portfolio</a> and{' '}
              <a class="link" href="/contact">get in touch</a> about any piece that catches your eye.
            </>
          )}
        </p>
      )
    }
  </header>
  {
    available.length > 0 && (
      <section class="container">
        <Gallery artworks={available} showPrice />
      </section>
    )
  }
</Base>
