---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getArtworks } from '../lib/artworks';
import { site } from '../site.config';

const artworks = await getArtworks();
const featured = artworks.filter((a) => a.data.featured);
const [hero, ...selected] = featured.length ? featured : artworks;
---

<Base>
  <section class="hero container">
    <a href={`/portfolio/${hero.id}`} class="hero-image">
      <Image src={hero.data.image} alt={hero.data.alt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </a>
    <div class="hero-caption">
      <span>{[hero.data.title, hero.data.year].filter(Boolean).join(', ')}</span>
      {hero.data.medium && <span>{hero.data.medium}</span>}
    </div>
  </section>

  <section class="intro container narrow">
    <p class="lede">{site.tagline}.</p>
    <a class="link" href="/about">About the artist</a>
  </section>

  <section class="container">
    <div class="section-head">
      <h2>Selected works</h2>
      <a class="link" href="/portfolio">View the full portfolio</a>
    </div>
    <Gallery artworks={selected} layout="row" />
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(1rem, 3vw, 2rem);
  }

  .hero-image {
    display: block;
    overflow: hidden;
    background: var(--paper-deep);
  }

  .hero-image :global(img) {
    width: 100%;
    max-height: 78vh;
    object-fit: cover;
  }

  .hero-caption {
    display: flex;
    justify-content: space-between;
    padding-top: 0.9rem;
    font-size: 0.78rem;
    color: var(--muted);
    letter-spacing: 0.04em;
  }

  .intro {
    text-align: center;
    padding-block: clamp(4rem, 10vw, 7rem);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: 0.9rem;
  }

  .section-head h2 {
    margin: 0;
  }
</style>
