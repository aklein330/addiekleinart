---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const all = (await getCollection('exhibitions')).sort((a, b) => +b.data.start - +a.data.start);
const today = new Date();
const upcoming = all.filter((e) => (e.data.end ?? e.data.start) >= today).reverse();
const past = all.filter((e) => (e.data.end ?? e.data.start) < today);

const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const range = (start: Date, end?: Date) => (end ? `${fmt.format(start)} – ${fmt.format(end)}` : fmt.format(start));
const typeLabel = { solo: 'Solo exhibition', group: 'Group exhibition', fair: 'Art fair' };
const groups = [
  { title: 'Upcoming & current', items: upcoming },
  { title: 'Past', items: past },
].filter((g) => g.items.length);
---

<Base title="Exhibitions" description="Current, upcoming, and past exhibitions.">
  <header class="page-header container">
    <p class="eyebrow">Exhibitions</p>
    <h1>Shows &amp; events</h1>
  </header>

  <div class="container">
    {
      groups.map((group) => (
        <section class="group">
          <h2>{group.title}</h2>
          <ul>
            {group.items.map(({ data }) => (
              <li>
                <span class="year">{data.start.getUTCFullYear()}</span>
                <div>
                  <h3>{data.url ? <a class="link" href={data.url} rel="noopener">{data.title}</a> : data.title}</h3>
                  <p>
                    {data.venue}, {data.city}
                  </p>
                </div>
                <div class="when">
                  <span>{range(data.start, data.end)}</span>
                  <span class="type">{typeLabel[data.type]}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .group + .group {
    margin-top: clamp(3rem, 7vw, 5rem);
  }

  h2 {
    font-size: 1.6rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  li {
    display: grid;
    grid-template-columns: 5rem 1fr auto;
    gap: 1.5rem;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .year {
    font-family: var(--serif);
    font-size: 1.3rem;
    color: var(--muted);
  }

  h3 {
    margin: 0 0 0.2rem;
  }

  li p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .when {
    display: grid;
    text-align: right;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .type {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 700px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }

    .when {
      text-align: left;
    }
  }
</style>
